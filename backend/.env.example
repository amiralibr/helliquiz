# ------------------------------------------------------------------
# پیکربندی نمونه بک‌اند (Strapi)
# این فایل را به .env کپی کنید و مقادیر را عوض کنید.
# ------------------------------------------------------------------

# ---------- سرور ----------
HOST=0.0.0.0
PORT=1337

# ---------- کلیدهای امنیتی ----------
# با دستور زیر کلیدهای تصادفی بسازید:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
APP_KEYS=key1,key2,key3,key4
API_TOKEN_SALT=change-me-api-token-salt
ADMIN_JWT_SECRET=change-me-admin-jwt-secret
TRANSFER_TOKEN_SALT=change-me-transfer-token-salt
ENCRYPTION_KEY=change-me-encryption-key
JWT_SECRET=change-me-users-permissions-jwt-secret

# ---------- دیتابیس ----------
# sqlite | postgres | mysql
DATABASE_CLIENT=sqlite
DATABASE_FILENAME=.tmp/data.db

# برای postgres یا mysql این‌ها را هم تنظیم کنید:
# DATABASE_HOST=localhost
# DATABASE_PORT=5432
# DATABASE_NAME=strapi
# DATABASE_USERNAME=strapi
# DATABASE_PASSWORD=strapi
# DATABASE_SSL=false

# ---------- امنیت ----------
# دامنه‌های مجاز CORS (با کاما جدا شوند). چون مرورگر از طریق پروکسی Next
# صحبت می‌کند، معمولاً نیازی به تغییر نیست. * یعنی همه دامنه‌ها.
CORS_ORIGINS=*
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300
BODY_JSON_LIMIT=256kb

# ---------- داده‌ی نمایشی ----------
# در اجرای اول: ساخت حساب دبیر، دو آزمون نمونه، حساب دانش‌آموز و یک کارنامه
SEED_DEMO=true
SEED_TEACHER_EMAIL=teacher@helli.ir
SEED_TEACHER_USERNAME=teacher
SEED_TEACHER_PASSWORD=teacher1234
SEED_STUDENT_NATIONAL_CODE=0012345678
SEED_STUDENT_PASSWORD=student1234
