{
  "kind": "collectionType",
  "collectionName": "questions",
  "info": {
    "singularName": "question",
    "pluralName": "questions",
    "displayName": "Question",
    "description": "سؤال چهارگزینه‌ای؛ correctOption ایندکس صفر-بیس گزینه صحیح است"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "questionText": {
      "type": "text",
      "required": true,
      "maxLength": 2000
    },
    "options": {
      "type": "json",
      "required": true
    },
    "correctOption": {
      "type": "integer",
      "min": 0,
      "description": "ایندکس صفر-بیس گزینه صحیح (0 = گزینه اول)"
    },
    "correctAnswer": {
      "type": "integer",
      "description": "صرفاً برای داده‌های قدیمی (یک-بیس). مقدار معتبر در correctOption نگه‌داری می‌شود."
    },
    "score": {
      "type": "integer",
      "default": 1,
      "min": 0
    },
    "quiz": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::quiz.quiz",
      "inversedBy": "questions"
    }
  }
}
